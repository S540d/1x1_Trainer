{
  "name": "1x1_trainer",
  "version": "1.7.0",
  "description": "Cross-platform 1x1 multiplication trainer with multiple game modes",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "homepage": "https://s540d.github.io/1x1_Trainer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/S540d/1x1_Trainer.git"
  },
  "bugs": {
    "url": "https://github.com/S540d/1x1_Trainer/issues"
  },
  "license": "MIT",
  "author": "S540d",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/post-build.js",
    "build:android": "eas build --platform android",
    "deploy": "npm run build:web && npm run deploy:gh-pages",
    "deploy:gh-pages": "gh-pages -d dist -t --dotfiles",
    "validate": "./scripts/validate-release.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "^57.0.31",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-font": "~57.0.0",
    "expo-linear-gradient": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.18",
    "gh-pages": "^6.3.0",
    "husky": "^9.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "minimatch@^3": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@^9": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@^10": {
      "brace-expansion": "^5.0.12"
    },
    "postcss": "^8.5.25",
    "protobufjs": "^7.6.5"
  }
}
